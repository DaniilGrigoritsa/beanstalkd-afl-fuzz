+/* Parses an unsigned decimal field the way beanstalkd's read_u32()/read_duration() do:
+   leading spaces are skipped and the field must start with a digit. Returns 0 on success. */
+static int bsd_read_num(const unsigned char **p, const unsigned char *end, unsigned long long *val)
+{
+  unsigned long long v = 0;
+  while (*p < end && **p == ' ') (*p)++;
+  if (*p >= end || **p < '0' || **p > '9') return -1;
+  while (*p < end && **p >= '0' && **p <= '9') {
+    v = v * 10 + (**p - '0');
+    if (v > 0xffffffffULL) return -1;
+    (*p)++;
+  }
+  *val = v;
+  return 0;
+}
+
+#define BSD_LINE_BUF 224 /* beanstalkd LINE_BUF_SIZE: its command buffer */
+
+/* beanstalkd's scan_line_end(): only the FIRST '\r' in the buffer counts, and it ends a line
+   only if '\n' follows. Returns the line length including "\r\n", or 0. */
+static unsigned int bsd_scan_line_end(const unsigned char *s, unsigned int size)
+{
+  const unsigned char *cr;
+  if (size < 2) return 0;
+  cr = memchr(s, '\r', size - 1);
+  if (cr && cr[1] == '\n') return cr - s + 2;
+  return 0;
+}
+
+/* Number of replies beanstalkd sends for the stream buf[*pos..buf_size). Emulates the server's
+   input handling, which does not depend on how the bytes are split into reads:
+   - the command buffer holds 224 bytes and a line ends at the first '\r' only if '\n' follows;
+   - a full buffer without a line end is discarded in 224-byte steps until a line end is found
+     in a window, which gets one BAD_FORMAT;
+   - a valid "put" header is followed by <bytes>+2 bytes of body (also when the body is too big
+     and gets discarded), and its reply comes once the body is complete;
+   - a line starting with "quit" closes the connection.
+   *pos is advanced past the last complete command, so the caller can feed the growing stream
+   of a session incrementally. */
+unsigned int count_expected_replies_beanstalkd(unsigned char* buf, unsigned int buf_size, unsigned int *pos_ref)
+{
+  unsigned int pos = *pos_ref, replies = 0;
+
+  while (pos < buf_size) {
+    unsigned int avail = buf_size - pos;
+    unsigned int window = avail < BSD_LINE_BUF ? avail : BSD_LINE_BUF;
+    unsigned int l = bsd_scan_line_end(buf + pos, window);
+    unsigned int next;
+
+    if (!l) {
+      unsigned int p;
+      if (window < BSD_LINE_BUF) break;  /* incomplete line: the server keeps waiting */
+      /* line too long: discard 224-byte windows until one contains a line end */
+      for (p = pos + BSD_LINE_BUF; ; p += BSD_LINE_BUF) {
+        unsigned int w = buf_size - p < BSD_LINE_BUF ? buf_size - p : BSD_LINE_BUF;
+        l = bsd_scan_line_end(buf + p, w);
+        if (l || w < BSD_LINE_BUF) break;
+      }
+      if (!l) break;  /* still discarding */
+      replies++;      /* BAD_FORMAT */
+      pos = p + l;
+      continue;
+    }
+
+    next = pos + l;
+    l -= 2;  /* without "\r\n" */
+
+    if (l >= 4 && !memcmp(buf + pos, "quit", 4)) {  /* connection is closed, nothing follows */
+      pos = UINT_MAX;  /* ...in later calls for this session either */
+      break;
+    }
+
+    if (l > 4 && !memcmp(buf + pos, "put ", 4) && !memchr(buf + pos, 0, l)) {
+      unsigned long long pri, delay, ttr, size;
+      const unsigned char *p = buf + pos + 4, *end = buf + pos + l;
+      if (!bsd_read_num(&p, end, &pri) && !bsd_read_num(&p, end, &delay) &&
+          !bsd_read_num(&p, end, &ttr) && !bsd_read_num(&p, end, &size) &&
+          (p == end || size > 65535)) {
+        /* job body (or the discarded too-big body) follows: the reply comes after it */
+        unsigned long long body_end = (unsigned long long)next + size + 2;
+        if (body_end > buf_size) break;
+        next = (unsigned int)body_end;
+      }
+    }
+
+    replies++;
+    pos = next;
+  }
+
+  *pos_ref = pos;
+  return replies;
+}
+
+/* Number of complete replies in buf[*pos..buf_size); *pos is advanced past the last one */
+unsigned int count_complete_replies_beanstalkd(unsigned char* buf, unsigned int buf_size, unsigned int *pos_ref)
+{
+  unsigned int pos = *pos_ref, replies = 0;
+
+  while (pos < buf_size) {
+    unsigned int eol = bsd_find_eol(buf, buf_size, pos);
+    unsigned long long id, body = 0;
+    const unsigned char *p = NULL, *end = buf + eol;
+    int has_body = 0;
+
+    if (eol >= buf_size) break;
+
+    /* RESERVED <id> <bytes>, FOUND <id> <bytes>, OK <bytes> carry a body + "\r\n" */
+    if (eol - pos > 9 && !memcmp(buf + pos, "RESERVED ", 9)) {
+      p = buf + pos + 9;
+      has_body = !bsd_read_num(&p, end, &id) && !bsd_read_num(&p, end, &body);
+    } else if (eol - pos > 6 && !memcmp(buf + pos, "FOUND ", 6)) {
+      p = buf + pos + 6;
+      has_body = !bsd_read_num(&p, end, &id) && !bsd_read_num(&p, end, &body);
+    } else if (eol - pos > 3 && !memcmp(buf + pos, "OK ", 3)) {
+      p = buf + pos + 3;
+      has_body = !bsd_read_num(&p, end, &body);
+    }
+
+    if (has_body) {
+      unsigned long long reply_end = (unsigned long long)eol + 2 + body + 2;
+      if (reply_end > buf_size) break;
+      pos = (unsigned int)reply_end;
+    } else {
+      pos = eol + 2;
+    }
+    replies++;
+  }
+
+  *pos_ref = pos;
+  return replies;
+}
