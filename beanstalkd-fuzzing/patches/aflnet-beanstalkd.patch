+/* ------------------------------------------------------------------ */
+/* beanstalkd (text protocol, commands/replies terminated by "\r\n")  */
+/* ------------------------------------------------------------------ */
+
+static const char *bsd_reply_words[] = {
+  "INSERTED", "BURIED", "EXPECTED_CRLF", "JOB_TOO_BIG", "DRAINING", "USING",
+  "RESERVED", "DEADLINE_SOON", "TIMED_OUT", "DELETED", "NOT_FOUND", "RELEASED",
+  "TOUCHED", "WATCHING", "NOT_IGNORED", "KICKED", "FOUND", "OK", "PAUSED",
+  "BAD_FORMAT", "UNKNOWN_COMMAND", "OUT_OF_MEMORY", "INTERNAL_ERROR", NULL
+};
+
+/* Index of the "\r\n" that terminates the line starting at pos, or buf_size if there is none. */
+static unsigned int bsd_find_eol(unsigned char* buf, unsigned int buf_size, unsigned int pos)
+{
+  while (pos + 1 < buf_size) {
+    if (buf[pos] == '\r' && buf[pos + 1] == '\n') return pos;
+    pos++;
+  }
+  return buf_size;
+}
+
+/* Adds a size (job body length) to an offset without overflow, clamped to buf_size. */
+static unsigned int bsd_skip(unsigned int from, unsigned int body_len, unsigned int buf_size)
+{
+  unsigned long long e = (unsigned long long)from + body_len + 2; /* body + "\r\n" */
+  return e > buf_size ? buf_size : (unsigned int)e;
+}
+
+region_t* extract_requests_beanstalkd(unsigned char* buf, unsigned int buf_size, unsigned int* region_count_ref)
+{
+  unsigned int pos = 0;
+  unsigned int region_count = 0;
+  region_t *regions = NULL;
+
+  while (pos < buf_size) {
+    unsigned int start = pos;
+    unsigned int eol = bsd_find_eol(buf, buf_size, pos);
+    unsigned int end = (eol < buf_size) ? eol + 2 : buf_size; /* exclusive */
+
+    /* "put <pri> <delay> <ttr> <bytes>\r\n<data>\r\n": the job body belongs to the same message */
+    if (eol < buf_size && end - start > 4 && memcmp(buf + start, "put ", 4) == 0) {
+      char line[256];
+      unsigned int l = eol - start;
+      unsigned int n = 0;
+      if (l > sizeof(line) - 1) l = sizeof(line) - 1;
+      memcpy(line, buf + start, l);
+      line[l] = 0;
+      if (sscanf(line, "put %*u %*u %*u %u", &n) == 1) end = bsd_skip(end, n, buf_size);
+    }
+
+    region_count++;
+    regions = (region_t *)ck_realloc(regions, region_count * sizeof(region_t));
+    regions[region_count - 1].start_byte = start;
+    regions[region_count - 1].end_byte = end - 1;
+    regions[region_count - 1].state_sequence = NULL;
+    regions[region_count - 1].state_count = 0;
+
+    pos = end;
+  }
+
+  *region_count_ref = region_count;
+  return regions;
+}
+
+unsigned int* extract_response_codes_beanstalkd(unsigned char* buf, unsigned int buf_size, unsigned int* state_count_ref)
+{
+  unsigned int pos = 0;
+  unsigned int state_count = 1;
+  unsigned int *state_sequence = (unsigned int *)ck_alloc(sizeof(unsigned int));
+  state_sequence[0] = 0; /* initial state */
+
+  while (pos < buf_size) {
+    unsigned int eol = bsd_find_eol(buf, buf_size, pos);
+    char line[256];
+    char word[32];
+    unsigned int l, i, code = 0, body = 0;
+    int has_body = 0;
+
+    if (eol >= buf_size) break; /* incomplete line */
+
+    l = eol - pos;
+    if (l > sizeof(line) - 1) l = sizeof(line) - 1;
+    memcpy(line, buf + pos, l);
+    line[l] = 0;
+
+    word[0] = 0;
+    sscanf(line, "%31s", word);
+
+    for (i = 0; bsd_reply_words[i]; i++) {
+      if (strcmp(word, bsd_reply_words[i]) == 0) { code = i + 1; break; }
+    }
+    if (code == 0) code = 99; /* unknown reply */
+
+    /* RESERVED <id> <bytes>, FOUND <id> <bytes>, OK <bytes> are followed by a body */
+    if (strcmp(word, "RESERVED") == 0 || strcmp(word, "FOUND") == 0) {
+      has_body = (sscanf(line, "%*s %*u %u", &body) == 1);
+    } else if (strcmp(word, "OK") == 0) {
+      has_body = (sscanf(line, "%*s %u", &body) == 1);
+    }
+
+    state_count++;
+    state_sequence = (unsigned int *)ck_realloc(state_sequence, state_count * sizeof(unsigned int));
+    state_sequence[state_count - 1] = get_mapped_message_code(code);
+
+    pos = eol + 2;
+    if (has_body) pos = bsd_skip(pos, body, buf_size);
+  }
+
+  *state_count_ref = state_count;
+  return state_sequence;
+}
